# Copy to .env and adjust as needed. All variables are optional:
# without .env, the defaults from src/my_diffusion/config.py are used.

MY_DIFFUSION_DEVICE=cuda

# Folder with links to the models (created by scripts/link_models.ps1) and the output folder.
# MY_DIFFUSION_MODELS_DIR=./models
# MY_DIFFUSION_OUTPUT_DIR=./outputs
# The checkpoints and LoRA folders can live elsewhere; unset = checkpoints/ and loras/ under MODELS_DIR.
# MY_DIFFUSION_CHECKPOINTS_DIR=D:\ComfyUI\models\checkpoints
# MY_DIFFUSION_LORAS_DIR=D:\ComfyUI\models\loras

MY_DIFFUSION_CHECKPOINT=krea2_turbo_mxfp8.safetensors   # file in models/checkpoints (.safetensors or .gguf)
MY_DIFFUSION_CHECKPOINT_KIND=auto                       # auto | turbo | raw - the default step count and guidance depend on this
MY_DIFFUSION_MATMUL=fp8_all                             # exact | fp8 | fp8_all - how to multiply matrices; fast modes (fp8*) only work with mxfp8 checkpoints and NVIDIA 50-series GPUs, on other cards use exact
MY_DIFFUSION_ATTENTION=cudnn                            # cudnn | default | sage2 - attention kernel; cudnn is 2-2.4x faster, default - whatever torch picks (for comparison with ComfyUI), sage2 - approximate, faster on large pictures (needs `uv sync --group sage2`)
MY_DIFFUSION_PIN_MEMORY=true                            # keep weights in pinned memory: switching models on the GPU takes ~0.5 s instead of ~3 s; turn off if RAM is short
MY_DIFFUSION_VAE=qwen_vae.safetensors                   # file in models/vae
MY_DIFFUSION_TEXT_ENCODER=Qwen3-VL-4B-Instruct          # folder in models/text_encoders

MY_DIFFUSION_ENHANCER_MAX_NEW_TOKENS=220

# --- job queue ---
# MY_DIFFUSION_DEVICES=auto                                # GPUs that run jobs: unset = MY_DIFFUSION_DEVICE only; auto = every CUDA device; or ["cuda:0","cuda:1"]. Each GPU holds its own copy of the models (~19 GB RAM each)
# MY_DIFFUSION_DATABASE_PATH=./data/jobs.sqlite3
# MY_DIFFUSION_INPUTS_DIR=./data/inputs
# MY_DIFFUSION_INPUTS_KEEP_DAYS=7                          # days to keep a job's input pictures; 0 = delete when the job ends
MY_DIFFUSION_QUEUE_MAX_PENDING=16                         # jobs waiting at once, all users together; more -> 429
MY_DIFFUSION_QUEUE_MAX_PER_USER=3                         # jobs waiting or running per user; admins are exempt

# --- access ---
# Unset = access control OFF, every caller is an admin (fine on 127.0.0.1 for one person).
# Each client gets its own random key of 16+ characters, sent as "Authorization: Bearer <key>".
# MY_DIFFUSION_API_KEYS={"web": "change-me-to-a-long-random-key", "telegram": "change-me-to-another-long-key"}
# MY_DIFFUSION_ADMIN_CLIENTS=["web"]

# API documentation pages: /docs (Swagger UI), /scalar, /redoc, /openapi.json. false = none of them.
MY_DIFFUSION_API_DOCS=true

# --- settings at run time (admin API: GET /config, PATCH /config, GET /fs; see guides/configuration.md) ---
# Settings changed through the API are saved in this file and read on top of the environment and .env.
# This .env is never written by the server.
# MY_DIFFUSION_SETTINGS_FILE=./data/settings.override.json
# Extra folders the admin API may show (GET /fs) and accept as model folders, besides the model folders in use.
# JSON list; backslashes are doubled. Cannot be changed through the API itself.
# MY_DIFFUSION_FS_ROOTS=["D:\\ComfyUI\\models", "D:\\AI"]

# For reference only: the address is given on the uvicorn command line (--host, --port).
MY_DIFFUSION_HOST=127.0.0.1
MY_DIFFUSION_PORT=8000
